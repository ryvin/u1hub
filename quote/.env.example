# Copy to quote/.env (gitignored). QUOTE_KEY comes from the Hub: Estimate tab -> Public quotes -> New key.
QUOTE_KEY=
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
PUBLIC_URL=https://quote.satisfyingprints3d.com
MAX_MB=100
UPLOADS_PER_HOUR=5
REQUESTS_PER_DAY=3
GLOBAL_UPLOADS_PER_HOUR=60
# Who may set CF-Connecting-IP (with TRUST_CF=1, which compose sets): the cloudflared
# container. IPs, CIDRs or hostnames, comma separated; a hostname is re-resolved every
# minute. Empty = nobody (every visitor shares the tunnel's limit). compose defaults it
# to snapmaker-cloudflared when this line is absent.
TRUSTED_PROXY=snapmaker-cloudflared
